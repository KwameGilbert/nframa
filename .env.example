PORT=3000
# Number of proxy hops in front of the app (e.g. 1 behind a load balancer); leave empty when running directly
TRUST_PROXY=
# Debug mode: set to "true" to expose full error details and stack traces to clients; "false" for production
DEBUG_ERRORS=false
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=1234
DB_NAME=nframa
DB_SSL=false

JWT_ACCESS_SECRET=changeme
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

ARKESEL_API_KEY=
ARKESEL_SENDER_ID=Nframa

RESEND_API_KEY=
RESEND_FROM_EMAIL=Nframa <onboarding@resend.dev>

# Optional: Google Directions API key for real driving distance and time. Without it (or when Google fails)
# fares fall back to straight-line distance at the trips.fallbackSpeedKmh setting
GOOGLE_MAPS_API_KEY=

# Optional: OAuth client ids allowed to sign in with Google / Apple, comma-separated (Google: the iOS, Android and
# web client ids; Apple: the bundle id and any services id). Without them POST /auth/social-login answers 503
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Optional: Paystack secret key for wallet top-ups (sk_test_... or sk_live_...). Without it top-ups and the
# webhook answer 503. Set the webhook URL in the Paystack dashboard to <api host>/webhooks/paystack
PAYSTACK_SECRET_KEY=
# Optional: domain for the stand-in email Paystack requires for accounts without one (<userId>@<domain>);
# defaults to example.com
PAYSTACK_FALLBACK_EMAIL_DOMAIN=
# Optional: where Paystack sends the rider after paying (otherwise the dashboard's callback URL)
PAYSTACK_CALLBACK_URL=

BOOTSTRAP_ADMIN_EMAIL=admin@nframa.com
BOOTSTRAP_ADMIN_PASSWORD=

# Where uploaded files (e.g. driver verification documents) are stored
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: access token for Expo push, only needed when "Enhanced Security for Push Notifications" is enabled on
# the Expo projects. Without it pushes are sent unauthenticated (fine otherwise)
EXPO_ACCESS_TOKEN=

# Optional: VAPID keys for browser (web) push; generate with `pnpm exec web-push generate-vapid-keys`. The private key
# is a secret. Without them web devices can't register (503) and no web push is sent; mobile push is unaffected
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: contact for the push providers, a mailto: or https: URL. Without it web push stays off
VAPID_SUBJECT=mailto:support@nframa.com
