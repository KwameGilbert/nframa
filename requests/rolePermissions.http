@baseUrl = http://localhost:3000

# Per-module permission management (the alternative to PATCHing a role's whole permission set).
# Needs the roles permission — a super-admin token has every permission. Get one via POST /auth/login.
@token = PASTE_ADMIN_ACCESS_TOKEN_HERE

### Create a role to manage
# @name createRole
POST {{baseUrl}}/roles
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "slug": "support-agent",
  "name": "Support Agent",
  "description": "Handles support tickets"
}

@roleId = {{createRole.response.body.data.id}}

### No token at all (expect 401)
GET {{baseUrl}}/roles/{{roleId}}/permissions

### Get the role's permissions (empty so far)
GET {{baseUrl}}/roles/{{roleId}}/permissions
Authorization: Bearer {{token}}

### Grant users: read + update (create/delete default to false)
PUT {{baseUrl}}/roles/{{roleId}}/permissions/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "read": true,
  "update": true
}

### Grant settings: read
PUT {{baseUrl}}/roles/{{roleId}}/permissions/settings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "read": true
}

### Unknown module (expect 400)
PUT {{baseUrl}}/roles/{{roleId}}/permissions/not-a-module
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "read": true
}

### Remove settings access
DELETE {{baseUrl}}/roles/{{roleId}}/permissions/settings
Authorization: Bearer {{token}}

### Setting every action false also removes the module
PUT {{baseUrl}}/roles/{{roleId}}/permissions/users
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### Permissions for a nonexistent role (expect 404)
GET {{baseUrl}}/roles/00000000-0000-0000-0000-000000000000/permissions
Authorization: Bearer {{token}}
