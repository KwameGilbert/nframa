@baseUrl = http://localhost:3000

# POST /role-permissions is admin-only - see users.http for how to get a token.
@token = PASTE_ADMIN_ACCESS_TOKEN_HERE

### Create a role for the permission to reference
# @name createRole
POST {{baseUrl}}/roles
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "slug": "support-agent",
  "name": "Support Agent",
  "description": "Read-only support access"
}

@roleId = {{createRole.response.body.id}}

### No token at all (expect 401)
POST {{baseUrl}}/role-permissions
Content-Type: application/json

{
  "roleId": "{{roleId}}",
  "permission": { "resource": "users", "actions": ["read"] }
}

### Create a role permission
# @name createPermission
POST {{baseUrl}}/role-permissions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roleId": "{{roleId}}",
  "permission": { "resource": "users", "actions": ["read"] }
}

@permissionId = {{createPermission.response.body.id}}

### Get by id (no auth required)
GET {{baseUrl}}/role-permissions/{{permissionId}}

### List all permissions for the role (no auth required)
GET {{baseUrl}}/roles/{{roleId}}/permissions

### Update the permission (no auth required)
PATCH {{baseUrl}}/role-permissions/{{permissionId}}
Content-Type: application/json

{
  "permission": { "resource": "users", "actions": ["read", "write"] }
}

### Get a nonexistent permission (expect 404)
GET {{baseUrl}}/role-permissions/00000000-0000-0000-0000-000000000000
