@baseUrl = http://localhost:3000

# Prerequisites:
# - pnpm migrate:rollback then pnpm migrate must have been run (otpCodes/authSessions tables)
# - ARKESEL_API_KEY / RESEND_API_KEY must be set in .env.development for delivery to actually work
# - Replace "code" below with whatever code you actually received before running verify

### Sign up a brand-new phone number (no account exists yet -> role required)
POST {{baseUrl}}/auth/otp/request
Content-Type: application/json

{
  "phoneCountryCode": "+233",
  "phoneNumber": "541436414",
  "role": "rider"
}

### Same new number, but no role provided (expect 400 - role required to sign up)
POST {{baseUrl}}/auth/otp/request
Content-Type: application/json

{
  "phoneCountryCode": "+233",
  "phoneNumber": "541436414"
}

### Verify the signup OTP (creates the user on success)
POST {{baseUrl}}/auth/otp/verify
Content-Type: application/json

{
  "phoneCountryCode": "+233",
  "phoneNumber": "541436414",
  "role": "rider",
  "code": "718740"
}

### Request OTP via phone for an EXISTING account (login, no role needed)
POST {{baseUrl}}/auth/otp/request
Content-Type: application/json

{
  "phoneCountryCode": "+233",
  "phoneNumber": "541436414"
}

### Request OTP via email (admin)
POST {{baseUrl}}/auth/otp/request
Content-Type: application/json

{
  "email": "ops-admin@example.com"
}

### Request OTP for an email with no account (expect 404 - email never self-signs-up)
POST {{baseUrl}}/auth/otp/request
Content-Type: application/json

{
  "email": "no-such-admin@example.com"
}

### Verify OTP via phone (replace code with the one received)
# @name verifyPhoneOtp
POST {{baseUrl}}/auth/otp/verify
Content-Type: application/json

{
  "phoneCountryCode": "+233",
  "phoneNumber": "541436414",
  "code": "718740"
}

### Verify with a wrong code (expect 400, increments attemptCount)
POST {{baseUrl}}/auth/otp/verify
Content-Type: application/json

{
  "phoneCountryCode": "+233",
  "phoneNumber": "541436414",
  "code": "000000"
}

### Verify OTP via email (admin) (replace code with the one received)
# @name verifyAdminOtp
POST {{baseUrl}}/auth/otp/verify
Content-Type: application/json

{
  "email": "ops-admin@example.com",
  "code": "123456"
}

@refreshToken = {{verifyPhoneOtp.response.body.refreshToken}}

### Refresh the token pair
# @name refreshed
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Refresh again with the now-rotated-out old token (expect 401)
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

@rotatedRefreshToken = {{refreshed.response.body.refreshToken}}

### Logout (revokes the session)
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{rotatedRefreshToken}}"
}

### Refresh after logout (expect 401)
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{rotatedRefreshToken}}"
}
