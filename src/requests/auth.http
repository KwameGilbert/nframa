@baseUrl = https://nframa.onrender.com

# Prerequisites:
# - pnpm migrate:rollback then pnpm migrate must have been run (otpCodes/authSessions tables)
# - ARKESEL_API_KEY / RESEND_API_KEY must be set in .env.development for delivery to actually work
# - Replace "code" below with whatever code you actually received before running verify
# - Password login needs an account with a password: set BOOTSTRAP_ADMIN_PASSWORD and run pnpm seed,
#   pass "password" to POST /admin, or use the forgot/reset requests at the bottom of this file

@adminEmail = admin@nframa.com

### Log in with email + password
# @name passwordLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "ChangeMe123!"
}

### Log in with a wrong password (expect 401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "wrong-password"
}

### Sign up a brand-new phone number (no account exists yet -> role required)
POST {{baseUrl}}/auth/login/otp
Content-Type: application/json

{
  "phoneCountryCode": "+233",
  "phoneNumber": "541436414",
  "role": "rider"
}

### Same new number, but no role provided (expect 400 - role required to sign up)
POST {{baseUrl}}/auth/login/otp
Content-Type: application/json

{
  "phoneCountryCode": "+233",
  "phoneNumber": "541436414"
}

### Verify the signup OTP (creates the user on success)
POST {{baseUrl}}/auth/login/verify
Content-Type: application/json

{
  "phoneCountryCode": "+233",
  "phoneNumber": "541436414",
  "role": "rider",
  "code": "718740"
}

### Request OTP via phone for an EXISTING account (login, no role needed)
POST {{baseUrl}}/auth/login/otp
Content-Type: application/json

{
  "phoneCountryCode": "+233",
  "phoneNumber": "541436414"
}

### Request OTP via email (admin)
POST {{baseUrl}}/auth/login/otp
Content-Type: application/json

{
  "email": "ops-admin@example.com"
}

### Request OTP for an email with no account (expect 404 - email never self-signs-up)
POST {{baseUrl}}/auth/login/otp
Content-Type: application/json

{
  "email": "no-such-admin@example.com"
}

### Verify OTP via phone (replace code with the one received)
# @name verifyPhoneOtp
POST {{baseUrl}}/auth/login/verify
Content-Type: application/json

{
  "phoneCountryCode": "+233",
  "phoneNumber": "541436414",
  "code": "718740"
}

### Verify with a wrong code (expect 400, increments attemptCount)
POST {{baseUrl}}/auth/login/verify
Content-Type: application/json

{
  "phoneCountryCode": "+233",
  "phoneNumber": "541436414",
  "code": "000000"
}

### Verify OTP via email (admin) (replace code with the one received)
# @name verifyAdminOtp
POST {{baseUrl}}/auth/login/verify
Content-Type: application/json

{
  "email": "ops-admin@example.com",
  "code": "123456"
}

@refreshToken = {{verifyPhoneOtp.response.body.data.refreshToken}}

### Sign up / sign in with Google (paste the ID token from Google Sign-In; role only needed for a new account)
# @name googleLogin
POST {{baseUrl}}/auth/social-login
Content-Type: application/json

{
  "provider": "google",
  "providerToken": "<google id token>",
  "role": "rider"
}

### Sign in with Apple, first time (pass the name Apple gave the app; it is never in the token)
POST {{baseUrl}}/auth/social-login
Content-Type: application/json

{
  "provider": "apple",
  "providerToken": "<apple id token>",
  "role": "rider",
  "fullName": "Ama Mensah"
}

### Add a phone to an account that signed up with Google/Apple (step 1: texts a code; signed in, no phone yet)
POST {{baseUrl}}/auth/phone/otp
Authorization: Bearer {{googleLogin.response.body.data.accessToken}}
Content-Type: application/json

{
  "phoneCountryCode": "+233",
  "phoneNumber": "541436414"
}

### Add the phone (step 2: the texted code plus a current ID token from the account's Google/Apple sign-in)
POST {{baseUrl}}/auth/phone/verify
Authorization: Bearer {{googleLogin.response.body.data.accessToken}}
Content-Type: application/json

{
  "phoneCountryCode": "+233",
  "phoneNumber": "541436414",
  "code": "123456",
  "provider": "google",
  "providerToken": "<google id token>"
}

### Social login with a garbage token (expect 401)
POST {{baseUrl}}/auth/social-login
Content-Type: application/json

{
  "provider": "google",
  "providerToken": "not-a-jwt"
}

### Refresh the token pair
# @name refreshed
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Refresh again with the now-rotated-out old token (expect 401)
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

@rotatedRefreshToken = {{refreshed.response.body.data.refreshToken}}

### Logout (revokes the session)
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{rotatedRefreshToken}}"
}

### Refresh after logout (expect 401)
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{rotatedRefreshToken}}"
}

### Forgot password (always 200, even for unknown emails)
POST {{baseUrl}}/auth/password/forgot
Content-Type: application/json

{
  "email": "{{adminEmail}}"
}

### Reset password with the emailed code (replace code; signs out every session)
POST {{baseUrl}}/auth/password/reset
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "code": "123456",
  "newPassword": "ChangeMe123!"
}

@accessToken = {{passwordLogin.response.body.data.accessToken}}

### Who am I — account, profile, and (for admins) adminRole + permissions
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}

### Change password while signed in (returns a fresh token pair; other sessions are signed out)
POST {{baseUrl}}/auth/password/change
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "ChangeMe123!",
  "newPassword": "EvenBetter456!"
}

### Change password to the same value (expect 400)
POST {{baseUrl}}/auth/password/change
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "ChangeMe123!",
  "newPassword": "ChangeMe123!"
}
