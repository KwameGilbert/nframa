@baseUrl = http://localhost:3000

# POST /users is admin-only now. To get a token:
# 1. pnpm exec tsx ./node_modules/knex/bin/cli.js seed:run   (creates the bootstrap admin from BOOTSTRAP_ADMIN_EMAIL)
# 2. Run auth.http's email-based request/verify flow for that address to get an accessToken
# 3. Paste it below
@token = PASTE_ADMIN_ACCESS_TOKEN_HERE

### No token at all (expect 401)
POST {{baseUrl}}/users
Content-Type: application/json


{
  "phoneCountryCode": "+233",
  "phoneNumber": "541436414",
  "role": "rider"
}

### Non-admin token would land here too (expect 403) - swap {{token}} for a rider/driver's own token to see it

### Create a rider
# @name createRider
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "phoneCountryCode": "+233",
  "phoneNumber": "541436414",
  "role": "rider"
}

### Create a driver
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "phoneCountryCode": "+233",
  "phoneNumber": "541436414",
  "role": "driver"
}

### Create an admin (email required, no phone)
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "admin@example.com",
  "role": "admin"
}

### Missing phone for a rider (expect 400)
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role": "rider"
}

### Missing email for an admin (expect 400)
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role": "admin"
}

@riderId = {{createRider.response.body.id}}

### Get the created rider
GET {{baseUrl}}/users/{{riderId}}
Authorization: Bearer {{token}}

### Update the rider's profile
PATCH {{baseUrl}}/users/{{riderId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Kwame Test",
  "email": "kwame@example.com",
  "dateOfBirth": "1995-06-20",
  "profilePicture": "https://cdn.example.com/avatar.png"
}

### Update with empty body (expect 400)
PATCH {{baseUrl}}/users/{{riderId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### Get a nonexistent user (expect 404)
GET {{baseUrl}}/users/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

### Get with a malformed id (expect 400)
GET {{baseUrl}}/users/not-a-uuid
Authorization: Bearer {{token}}

### Delete the rider (soft delete — expect 204; a rider can also delete their own account with their own token)
DELETE {{baseUrl}}/users/{{riderId}}
Authorization: Bearer {{token}}

### Delete the same rider again (expect 409, already deleted)
DELETE {{baseUrl}}/users/{{riderId}}
Authorization: Bearer {{token}}

### The deleted rider is still readable, with deletedAt set
GET {{baseUrl}}/users/{{riderId}}
Authorization: Bearer {{token}}

### Delete a nonexistent user (expect 404)
DELETE {{baseUrl}}/users/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}
